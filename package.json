{
  "name": "node-quality-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Ratchet-style quality gate for Node repositories: copy a script and a workflow, and never let coverage, lint or duplication get worse.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mts\"",
    "test:e2e": "node test/e2e/run.mts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3"
  }
}
