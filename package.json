{
  "name": "node-quality-gate",
  "version": "0.1.1",
  "private": true,
  "description": "Ratchet-style quality gate for Node repositories: copy a script and a workflow, and never let coverage, lint or duplication get worse.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.mts\"",
    "test:coverage": "node -e \"fs.mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-include=\"template/scripts/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.mts\"",
    "test:e2e": "node test/e2e/run.mts",
    "gate": "node template/scripts/quality-gate/cli.mts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
